# Required on Vercel (Project → Settings → Environment Variables)
JWT_SECRET=change-this-to-a-long-random-string

# AI (Google Gemini). Without it the app still works using the built-in rule engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Persistence (PostgreSQL, e.g. Neon / Supabase / Vercel Postgres). Without it data resets on cold start.
DATABASE_URL=
